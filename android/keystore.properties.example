# Copy this file to `android/keystore.properties` and fill in your real values.
#
#   cp android/keystore.properties.example android/keystore.properties
#
# keystore.properties is gitignored and must NEVER be committed. This .example
# file is committed purely as documentation — keep it free of real secrets.
#
# Only needed for LOCAL release builds. CI reads the same values from the
# PS_KEYSTORE_PATH / PS_KEYSTORE_PASSWORD / PS_KEY_ALIAS / PS_KEY_PASSWORD
# environment variables, which come from GitHub Actions secrets.
#
# storeFile is resolved relative to the android/ directory, so a keystore in the
# repository root is "../release.jks".

storeFile=../release.jks
storePassword=CHANGEME
keyAlias=pulse-streak
keyPassword=CHANGEME
